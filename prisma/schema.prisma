// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Users table - single user for personal use
model User {
  id        String     @id @default(cuid())
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  categories        Category[]
  periods           Period[]
  ledgerEntries     LedgerEntry[]
  savingsAllocations SavingsAllocation[]
  notes             Note[]
}

// Categories - financial categorization
model Category {
  id              String  @id @default(cuid())
  userId          String
  name            String
  type            CategoryType
  group           CategoryGroup
  color           String  @default("#gray")
  icon            String  @default("Wallet")
  countsAsExpense Boolean @default(false)
  countsAsSavings Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledgerEntries LedgerEntry[]

  @@unique([userId, name])
  @@index([userId])
}

enum CategoryType {
  INCOME
  SPEND
  MISC
  PARTNERSHIP
  OTHER
  GROCERY
  PHONE
  SAVINGS
  RENT
  DEBT
}

enum CategoryGroup {
  ESSENTIAL
  LIFESTYLE
  AVOIDABLE
  VALUES
  WEALTH
  INCOME
}

// Periods - biweekly pay periods
model Period {
  id                    String   @id @default(cuid())
  userId                String
  label                 String   // e.g., "Jan 9 - Jan 22"
  payDate               DateTime // Payday of this period
  startDate             DateTime
  endDate               DateTime
  openingCash           Decimal  @db.Decimal(12, 2)
  closingCashExpected   Decimal  @db.Decimal(12, 2) @default(0)
  closingCashActual     Decimal? @db.Decimal(12, 2)
  status                PeriodStatus @default(OPEN)
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledgerEntries LedgerEntry[]
  periodNotes   Note[]

  @@unique([userId, startDate, endDate])
  @@index([userId])
  @@index([payDate])
}

enum PeriodStatus {
  OPEN
  CLOSED
  RECONCILED
}

// Ledger Entries - canonical source of all money movements
model LedgerEntry {
  id            String   @id @default(cuid())
  userId        String
  periodId      String
  date          DateTime
  amount        Decimal  @db.Decimal(12, 2)
  categoryId    String
  entryType     LedgerEntryType
  source        String? // transaction, summary, manual, etc
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  period             Period             @relation(fields: [periodId], references: [id], onDelete: Cascade)
  category           Category           @relation(fields: [categoryId], references: [id])
  savingsAllocations SavingsAllocation[]
  notes              Note[]

  @@index([userId])
  @@index([periodId])
  @@index([categoryId])
  @@index([date])
  @@index([entryType])
}

enum LedgerEntryType {
  INCOME
  EXPENSE
  TRANSFER
  SUMMARY_ENTRY
  ADJUSTMENT
}

// Savings Allocations - bucket breakdown for savings entries
model SavingsAllocation {
  id             String   @id @default(cuid())
  ledgerEntryId  String
  userId         String
  bucket         String   // Emergency Fund, Investments, Short Term Savings, Custom
  amount         Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledgerEntry  LedgerEntry  @relation(fields: [ledgerEntryId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([ledgerEntryId])
}

// Notes - flexible notes on transactions, periods, or summaries
model Note {
  id            String   @id @default(cuid())
  userId        String
  periodId      String?
  ledgerEntryId String?
  content       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  period       Period?      @relation(fields: [periodId], references: [id], onDelete: Cascade)
  ledgerEntry  LedgerEntry? @relation(fields: [ledgerEntryId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([periodId])
  @@index([ledgerEntryId])
}
