# Database Connection
# Get your Neon PostgreSQL connection string from https://console.neon.tech/
DATABASE_URL="postgresql://user:password@ep-your-project.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Next.js Environment
NEXT_PUBLIC_APP_NAME="Denari"
NEXT_PUBLIC_APP_DESCRIPTION="Personal Financial Command Center"

# Feature flags
NEXT_PUBLIC_ENABLE_PWA="true"
NEXT_PUBLIC_ENABLE_FORECASTS="true"
NEXT_PUBLIC_ENABLE_ADVANCED_REPORTS="true"

# App Configuration
NEXT_PUBLIC_FIRST_PAYDAY="2026-01-09"
NEXT_PUBLIC_PAY_CYCLE_DAYS="14"
