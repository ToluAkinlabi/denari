# Database Connection
# Get your Neon PostgreSQL connection string from https://console.neon.tech/
# DATABASE_URL uses the pooled connection (pgBouncer) — used by the app at runtime
DATABASE_URL="postgresql://username:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL uses the direct (non-pooled) connection — required for Prisma migrations
DIRECT_URL="postgresql://username:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Next.js Environment
NEXT_PUBLIC_APP_NAME="Denari"
NEXT_PUBLIC_APP_DESCRIPTION="Personal Financial Command Center"

# Feature flags
NEXT_PUBLIC_ENABLE_PWA="true"
NEXT_PUBLIC_ENABLE_FORECASTS="true"
NEXT_PUBLIC_ENABLE_ADVANCED_REPORTS="true"
